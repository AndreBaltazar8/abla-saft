    val out: array<SaftTaxEntry> = []
    out.append(SaftTaxEntry("IVA", "PT", "NOR", "Taxa normal", percentage = dec("23")))
    out.append(SaftTaxEntry("IVA", "PT", "INT", "Taxa intermédia", percentage = dec("13")))
    out.append(SaftTaxEntry("IVA", "PT", "RED", "Taxa reduzida", percentage = dec("6")))
    out.append(SaftTaxEntry("IVA", "PT", "ISE", "Isenta", percentage = dec("0")))
