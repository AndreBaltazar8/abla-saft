// Documents the tests write. All the people and numbers are invented; 599999993 is the
// NIF of AT's own demonstration file. Rates here are examples for the arithmetic: the
// library takes rates as data and doesn't assert any as current law.
import "../../src/saft.ab"
import "abla/bytes"
import "abla/crypto"
import "abla/text"

val sampleCertificate = 0

class FakeSigner(val version: int = 1) : SaftSigner {
    fun keyVersion(): int = version

    // Deterministic 128 bytes from SHA-1, so golden files hold no real key's work. It's
    // not a signature: no RSA key could verify it.
    fun sign(message: string): string {
        val out = byteBuffer()
        var block = sha1(message)
        while (out.size() < saftSignatureBytes) {
            out.appendText(block)
            block = sha1(block)
        }
        out.toText().slice(0, saftSignatureBytes)
    }
}

fun sampleAddress(country: string = "PT"): SaftAddress =
    SaftAddress("Rua das Flores, 12 - 1.º", "Coimbra", "3000-123", country, streetName = "Rua das Flores", buildingNumber = "12", region = "Coimbra")

fun sampleHeader(year: int = 2026): SaftHeader =
    SaftHeader("Conservatória de Coimbra 1234/56", "599999993", "Exemplo & Companhia, Lda.", sampleAddress(), year,
        "$year-01-01", "$year-12-31", "$year-12-31", "599999993", "abla-saft tests/Exemplo", "0.1.0", businessName = "Açúcar é Bom", email = "geral@example.pt")

fun sampleCustomers(): array<SaftCustomer> {
    val out: array<SaftCustomer> = []
    out.append(SaftCustomer("CF", saftFinalConsumerTaxId, "Consumidor final",
        SaftAddress(saftUnknown, saftUnknown, saftUnknown, saftUnknown)))
    out.append(SaftCustomer("C1", "500000000", "Cliente Português, S.A.", sampleAddress(), telephone = "+351 239 000 000"))
    out.append(SaftCustomer("C2", "4443332215", "Client Français SARL",
        SaftAddress("1 Rue de la Paix", "Paris", "75002", "FR"), accountId = "2111"))
    out
}

fun sampleSuppliers(): array<SaftSupplier> {
    val out: array<SaftSupplier> = []
    out.append(SaftSupplier("S1", "500000000", "Fornecedor, Lda.", sampleAddress()))
    out
}

