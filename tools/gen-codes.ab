// Generates src/codes.ab from the official XSD: the country and currency lists are too long
// to copy by hand. Reads the schema with abla-xml; writes the module to the standard output.
//   build/gen-codes .sources/saftpt1.04_01.xsd > src/codes.ab
// `make check-codes` regenerates it and compares with the committed file, byte for byte.
import github("AndreBaltazar8/abla-xml")
import "abla/fs"
import "abla/io"
import "abla/process"

// The restriction of a top-level element (whose simple type is anonymous) or of a named simple type.
fun restrictionOf(item: XmlElement, kind: string): XmlElement? {
    if (kind != "element") return item.child("restriction")
    val simple = item.child("simpleType")
    if (simple == null) null else simple.child("restriction")
}

// Its pattern.
fun pattern(root: XmlElement, kind: string, name: string): string? {
    for (item in root.elements(kind)) {
        if (item.attributeValue("name") != name) continue
        val restriction = restrictionOf(item, kind)
        if (restriction == null) return null
        val found = restriction.child("pattern")
        if (found == null) return null
        return found.attributeValue("value")
    }
    null
}

fun main: int {
    if (processArgumentCount() != 1) {
        eprintln("usage: gen-codes <saftpt1.04_01.xsd>")
        return 2
    }
    val parsed = xmlParse(path(processArgument(0)).readText())
    val document = parsed.document
    if (document == null) {
        eprintln("the schema isn't well-formed")
        return 2
    }
    val root = document.root
    var out = "// Generated by tools/gen-codes.ab from saftpt1.04_01.xsd. Don't edit.\n"
    out = out + "import \"abla/text\"\n\n"
    for (row in [
        ["saftCountryCodes", "element", "Country"],
        ["saftCustomerCountryCodes", "simpleType", "CustomerCountry"],
        ["saftTaxRegionCodes", "element", "TaxCountryRegion"],
        ["saftCurrencyCodes", "element", "CurrencyCode"]
    ]) {
        val p = pattern(root, row[1], row[2])
        if (p == null) {
            eprintln("${row[2]} not in the schema")
            return 2
        }
        out = out + "val ${row[0]} = \"|$p|\"\n\n"
    }
    out = out + "fun saftCodeIn(codes: string, code: string): bool = code != \"\" && !code.contains(\"|\") && codes.contains(\"|\" + code + \"|\")\n"
    print(out)
    0
}
