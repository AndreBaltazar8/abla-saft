// Writes the file through abla-xml, in the order the XSD's sequences require.
import github("AndreBaltazar8/abla-xml")
import "decimal.ab"
import "model.ab"
import "check.ab"
import "totals.ab"
import "abla/fs"

// The XSD and AT's demonstration file both declare Windows-1252, and the Portaria
// doesn't name an encoding (SOURCES.md). Characters outside it become references.
class SaftWriteOptions(
    val encoding: string = "Windows-1252",
    val indent: string = "  ",
    // Skips the check. Only for tests that must produce an invalid file.
    val unchecked: bool = false
)

class SaftWriteResult(
    val succeeded: bool,
    val text: string,
    val issues: array<SaftIssue>,
    val errorMessage: string
)

private fun opt(var w: XmlWriter, name: string, value: string): void {
    if (value != "") w.element(name, value)
    return
}

private fun optDec(var w: XmlWriter, name: string, value: SaftDecimal?): void {
    if (value != null) w.element(name, value.text())
    return
}

private fun optInt(var w: XmlWriter, name: string, value: int): void {
    if (value != 0) w.element(name, "$value")
    return
}

private fun address(var w: XmlWriter, name: string, a: SaftAddress): void {
    w.startElement(name)
    opt(w, "BuildingNumber", a.buildingNumber)
    opt(w, "StreetName", a.streetName)
    w.element("AddressDetail", a.addressDetail)
    w.element("City", a.city)
    w.element("PostalCode", a.postalCode)
    opt(w, "Region", a.region)
    w.element("Country", a.country)
    w.endElement()
    return
}

private fun header(var w: XmlWriter, h: SaftHeader): void {
    w.startElement("Header")
    w.element("AuditFileVersion", saftAuditFileVersion)
    w.element("CompanyID", h.companyId)
    w.element("TaxRegistrationNumber", h.taxRegistrationNumber)
    w.element("TaxAccountingBasis", h.taxAccountingBasis)
    w.element("CompanyName", h.companyName)
    opt(w, "BusinessName", h.businessName)
    address(w, "CompanyAddress", h.companyAddress)
    w.element("FiscalYear", "${h.fiscalYear}")
    w.element("StartDate", h.startDate)
    w.element("EndDate", h.endDate)
    w.element("CurrencyCode", h.currencyCode)
    w.element("DateCreated", h.dateCreated)
    w.element("TaxEntity", h.taxEntity)
    w.element("ProductCompanyTaxID", h.productCompanyTaxId)
    w.element("SoftwareCertificateNumber", "${h.softwareCertificateNumber}")
    w.element("ProductID", h.productId)
    w.element("ProductVersion", h.productVersion)
    opt(w, "HeaderComment", h.headerComment)
    opt(w, "Telephone", h.telephone)
    opt(w, "Fax", h.fax)
    opt(w, "Email", h.email)
    opt(w, "Website", h.website)
    w.endElement()
    return
}

private fun masterFiles(var w: XmlWriter, m: SaftMasterFiles): void {
    w.startElement("MasterFiles")
    for (c in m.customers) {
        w.startElement("Customer")
        w.element("CustomerID", c.customerId)
        w.element("AccountID", c.accountId)
        w.element("CustomerTaxID", c.customerTaxId)
        w.element("CompanyName", c.companyName)
        opt(w, "Contact", c.contact)
        address(w, "BillingAddress", c.billingAddress)
        for (a in c.shipToAddresses) address(w, "ShipToAddress", a)
        opt(w, "Telephone", c.telephone)
        opt(w, "Fax", c.fax)
        opt(w, "Email", c.email)
        opt(w, "Website", c.website)
        w.element("SelfBillingIndicator", "${c.selfBillingIndicator}")
        w.endElement()
    }
    for (s in m.suppliers) {
        w.startElement("Supplier")
        w.element("SupplierID", s.supplierId)
        w.element("AccountID", s.accountId)
        w.element("SupplierTaxID", s.supplierTaxId)
        w.element("CompanyName", s.companyName)
        opt(w, "Contact", s.contact)
        address(w, "BillingAddress", s.billingAddress)
        for (a in s.shipFromAddresses) address(w, "ShipFromAddress", a)
        opt(w, "Telephone", s.telephone)
        opt(w, "Fax", s.fax)
        opt(w, "Email", s.email)
        opt(w, "Website", s.website)
        w.element("SelfBillingIndicator", "${s.selfBillingIndicator}")
        w.endElement()
    }
    for (p in m.products) {
        w.startElement("Product")
        w.element("ProductType", p.productType)
        w.element("ProductCode", p.productCode)
        opt(w, "ProductGroup", p.productGroup)
        w.element("ProductDescription", p.productDescription)
        w.element("ProductNumberCode", p.productNumberCode)
        if (p.cnCodes.size > 0 || p.unNumbers.size > 0) {
            w.startElement("CustomsDetails")
            for (code in p.cnCodes) w.element("CNCode", code)
            for (code in p.unNumbers) w.element("UNNumber", code)
            w.endElement()
        }
        w.endElement()
    }
    if (m.taxTable.size > 0) {
        w.startElement("TaxTable")
        for (t in m.taxTable) {
            w.startElement("TaxTableEntry")
            w.element("TaxType", t.taxType)
            w.element("TaxCountryRegion", t.taxCountryRegion)
            w.element("TaxCode", t.taxCode)
            w.element("Description", t.description)
            opt(w, "TaxExpirationDate", t.taxExpirationDate)
            optDec(w, "TaxPercentage", t.percentage)
            optDec(w, "TaxAmount", t.amount)
            w.endElement()
        }
        w.endElement()
    }
    w.endElement()
    return
}

private fun status(var w: XmlWriter, prefix: string, sourceName: string, s: SaftDocumentStatus): void {
    w.startElement("DocumentStatus")
    w.element(prefix + "Status", s.status)
    w.element(prefix + "StatusDate", s.statusDate)
    opt(w, "Reason", s.reason)
    w.element("SourceID", s.sourceId)
    w.element(sourceName, s.sourceBilling)
    w.endElement()
    return
}

private fun shipping(var w: XmlWriter, name: string, point: SaftShippingPoint?): void {
    if (point == null) return
    w.startElement(name)
    for (id in point.deliveryIds) w.element("DeliveryID", id)
    opt(w, "DeliveryDate", point.deliveryDate)
    for (place in point.warehouses) {
        opt(w, "WarehouseID", place.warehouseId)
        opt(w, "LocationID", place.locationId)
    }
    val a = point.address
    if (a != null) address(w, "Address", a)
    w.endElement()
    return
}

private fun taxElement(var w: XmlWriter, tax: SaftTax?): void {
    if (tax == null) return
    w.startElement("Tax")
    w.element("TaxType", tax.taxType)
    w.element("TaxCountryRegion", tax.taxCountryRegion)
    w.element("TaxCode", tax.taxCode)
    optDec(w, "TaxPercentage", tax.percentage)
    optDec(w, "TaxAmount", tax.amount)
    w.endElement()
    return
}

// `movement` leaves out the three fields a stock movement line doesn't have.
private fun line(var w: XmlWriter, l: SaftLine, movement: bool): void {
    w.startElement("Line")
    w.element("LineNumber", "${l.lineNumber}")
    for (o in l.orderReferences) {
        w.startElement("OrderReferences")
        opt(w, "OriginatingON", o.originatingOn)
        opt(w, "OrderDate", o.orderDate)
        w.endElement()
    }
    w.element("ProductCode", l.productCode)
    w.element("ProductDescription", l.productDescription)
    w.element("Quantity", l.quantity.text())
    w.element("UnitOfMeasure", l.unitOfMeasure)
    w.element("UnitPrice", l.unitPrice.text())
    if (!movement) {
        optDec(w, "TaxBase", l.taxBase)
        w.element("TaxPointDate", l.taxPointDate)
        for (r in l.references) {
            w.startElement("References")
            opt(w, "Reference", r.reference)
            opt(w, "Reason", r.reason)
            w.endElement()
        }
    }
    w.element("Description", l.description)
    if (l.serialNumbers.size > 0) {
        w.startElement("ProductSerialNumber")
        for (n in l.serialNumbers) w.element("SerialNumber", n)
        w.endElement()
    }
    optDec(w, "DebitAmount", l.debitAmount)
    optDec(w, "CreditAmount", l.creditAmount)
    taxElement(w, l.tax)
    opt(w, "TaxExemptionReason", l.taxExemptionReason)
    opt(w, "TaxExemptionCode", l.taxExemptionCode)
    optDec(w, "SettlementAmount", l.settlementAmount)
    if (l.arcNumbers.size > 0 || l.iecAmount != null) {
        w.startElement("CustomsInformation")
        for (n in l.arcNumbers) w.element("ARCNo", n)
        optDec(w, "IECAmount", l.iecAmount)
        w.endElement()
    }
    w.endElement()
    return
}

private fun currency(var w: XmlWriter, c: SaftCurrency?): void {
    if (c == null) return
    w.startElement("Currency")
    w.element("CurrencyCode", c.currencyCode)
    w.element("CurrencyAmount", c.currencyAmount.text())
    w.element("ExchangeRate", c.exchangeRate.text())
    w.endElement()
    return
}

private fun paymentMethod(var w: XmlWriter, name: string, p: SaftPaymentMethod): void {
    w.startElement(name)
    opt(w, "PaymentMechanism", p.paymentMechanism)
    w.element("PaymentAmount", p.paymentAmount.text())
    w.element("PaymentDate", p.paymentDate)
    w.endElement()
    return
}

private fun totalsStart(var w: XmlWriter, t: SaftDocumentTotals): void {
    w.startElement("DocumentTotals")
    w.element("TaxPayable", t.taxPayable.text())
    w.element("NetTotal", t.netTotal.text())
    w.element("GrossTotal", t.grossTotal.text())
    return
}

private fun withholding(var w: XmlWriter, items: array<SaftWithholding>): void {
    for (item in items) {
        w.startElement("WithholdingTax")
        opt(w, "WithholdingTaxType", item.withholdingTaxType)
        opt(w, "WithholdingTaxDescription", item.description)
        w.element("WithholdingTaxAmount", item.amount.text())
        w.endElement()
    }
    return
}

private fun sectionStart(var w: XmlWriter, name: string, entries: int, debit: SaftDecimal, credit: SaftDecimal): void {
    w.startElement(name)
    w.element("NumberOfEntries", "$entries")
    w.element("TotalDebit", debit.text())
    w.element("TotalCredit", credit.text())
    return
}

private fun movementsStart(var w: XmlWriter, lines: int, quantity: SaftDecimal): void {
    w.startElement("MovementOfGoods")
    w.element("NumberOfMovementLines", "$lines")
    w.element("TotalQuantityIssued", quantity.text())
    return
}

private fun invoiceDocument(var w: XmlWriter, d: SaftInvoice): void {
    w.startElement("Invoice")
    w.element("InvoiceNo", d.invoiceNo)
    w.element("ATCUD", d.atcud)
    status(w, "Invoice", "SourceBilling", d.status)
    w.element("Hash", d.hash)
    w.element("HashControl", d.hashControl)
    optInt(w, "Period", d.period)
    w.element("InvoiceDate", d.invoiceDate)
    w.element("InvoiceType", d.invoiceType)
    w.startElement("SpecialRegimes")
    w.element("SelfBillingIndicator", "${d.selfBillingIndicator}")
    w.element("CashVATSchemeIndicator", "${d.cashVatSchemeIndicator}")
    w.element("ThirdPartiesBillingIndicator", "${d.thirdPartiesBillingIndicator}")
    w.endElement()
    w.element("SourceID", d.sourceId)
    opt(w, "EACCode", d.eacCode)
    w.element("SystemEntryDate", d.systemEntryDate)
    opt(w, "TransactionID", d.transactionId)
    w.element("CustomerID", d.customerId)
    shipping(w, "ShipTo", d.shipTo)
    shipping(w, "ShipFrom", d.shipFrom)
    opt(w, "MovementEndTime", d.movementEndTime)
    opt(w, "MovementStartTime", d.movementStartTime)
    for (l in d.lines) line(w, l, false)
    totalsStart(w, d.totals)
    currency(w, d.totals.currency)
    for (s in d.totals.settlements) {
        w.startElement("Settlement")
        opt(w, "SettlementDiscount", s.settlementDiscount)
        optDec(w, "SettlementAmount", s.settlementAmount)
        opt(w, "SettlementDate", s.settlementDate)
        opt(w, "PaymentTerms", s.paymentTerms)
        w.endElement()
    }
    for (p in d.totals.payments) paymentMethod(w, "Payment", p)
    w.endElement()
    withholding(w, d.withholding)
    w.endElement()
    return
}

private fun invoices(var w: XmlWriter, section: SaftSalesInvoices?): void {
    if (section == null) return
    sectionStart(w, "SalesInvoices", section.numberOfEntries, section.totalDebit, section.totalCredit)
    for (d in section.invoices) invoiceDocument(w, d)
    w.endElement()
    return
}

private fun movementDocument(var w: XmlWriter, d: SaftStockMovement): void {
    w.startElement("StockMovement")
    w.element("DocumentNumber", d.documentNumber)
    w.element("ATCUD", d.atcud)
    status(w, "Movement", "SourceBilling", d.status)
    w.element("Hash", d.hash)
    w.element("HashControl", d.hashControl)
    optInt(w, "Period", d.period)
    w.element("MovementDate", d.movementDate)
    w.element("MovementType", d.movementType)
    w.element("SystemEntryDate", d.systemEntryDate)
    opt(w, "TransactionID", d.transactionId)
    opt(w, "CustomerID", d.customerId)
    opt(w, "SupplierID", d.supplierId)
    w.element("SourceID", d.sourceId)
    opt(w, "EACCode", d.eacCode)
    opt(w, "MovementComments", d.movementComments)
    shipping(w, "ShipTo", d.shipTo)
    shipping(w, "ShipFrom", d.shipFrom)
    opt(w, "MovementEndTime", d.movementEndTime)
    w.element("MovementStartTime", d.movementStartTime)
    opt(w, "ATDocCodeID", d.atDocCodeId)
    for (l in d.lines) line(w, l, true)
    totalsStart(w, d.totals)
    currency(w, d.totals.currency)
    w.endElement()
    w.endElement()
    return
}

private fun movements(var w: XmlWriter, section: SaftMovementOfGoods?): void {
    if (section == null) return
    movementsStart(w, section.numberOfMovementLines, section.totalQuantityIssued)
    for (d in section.movements) movementDocument(w, d)
    w.endElement()
    return
}

private fun workDocumentElement(var w: XmlWriter, d: SaftWorkDocument): void {
    w.startElement("WorkDocument")
    w.element("DocumentNumber", d.documentNumber)
    w.element("ATCUD", d.atcud)
    status(w, "Work", "SourceBilling", d.status)
    w.element("Hash", d.hash)
    w.element("HashControl", d.hashControl)
    optInt(w, "Period", d.period)
    w.element("WorkDate", d.workDate)
    w.element("WorkType", d.workType)
    w.element("SourceID", d.sourceId)
    opt(w, "EACCode", d.eacCode)
    w.element("SystemEntryDate", d.systemEntryDate)
    opt(w, "TransactionID", d.transactionId)
    w.element("CustomerID", d.customerId)
    for (l in d.lines) line(w, l, false)
    totalsStart(w, d.totals)
    currency(w, d.totals.currency)
    w.endElement()
    w.endElement()
    return
}

private fun workDocuments(var w: XmlWriter, section: SaftWorkingDocuments?): void {
    if (section == null) return
    sectionStart(w, "WorkingDocuments", section.numberOfEntries, section.totalDebit, section.totalCredit)
    for (d in section.documents) workDocumentElement(w, d)
    w.endElement()
    return
}

private fun paymentDocument(var w: XmlWriter, d: SaftPayment): void {
    w.startElement("Payment")
    w.element("PaymentRefNo", d.paymentRefNo)
    w.element("ATCUD", d.atcud)
    optInt(w, "Period", d.period)
    opt(w, "TransactionID", d.transactionId)
    w.element("TransactionDate", d.transactionDate)
    w.element("PaymentType", d.paymentType)
    opt(w, "Description", d.description)
    opt(w, "SystemID", d.systemId)
    status(w, "Payment", "SourcePayment", d.status)
    for (p in d.methods) paymentMethod(w, "PaymentMethod", p)
    w.element("SourceID", d.sourceId)
    w.element("SystemEntryDate", d.systemEntryDate)
    w.element("CustomerID", d.customerId)
    for (l in d.lines) {
        w.startElement("Line")
        w.element("LineNumber", "${l.lineNumber}")
        for (s in l.sourceDocuments) {
            w.startElement("SourceDocumentID")
            w.element("OriginatingON", s.originatingOn)
            w.element("InvoiceDate", s.invoiceDate)
            opt(w, "Description", s.description)
            w.endElement()
        }
        optDec(w, "SettlementAmount", l.settlementAmount)
        optDec(w, "DebitAmount", l.debitAmount)
        optDec(w, "CreditAmount", l.creditAmount)
        taxElement(w, l.tax)
        opt(w, "TaxExemptionReason", l.taxExemptionReason)
        opt(w, "TaxExemptionCode", l.taxExemptionCode)
        w.endElement()
    }
    totalsStart(w, d.totals)
    val settled = d.totals.settlementAmount
    if (settled != null) {
        w.startElement("Settlement")
        w.element("SettlementAmount", settled.text())
        w.endElement()
    }
    currency(w, d.totals.currency)
    w.endElement()
    withholding(w, d.withholding)
    w.endElement()
    return
}

private fun receipts(var w: XmlWriter, section: SaftPayments?): void {
    if (section == null) return
    sectionStart(w, "Payments", section.numberOfEntries, section.totalDebit, section.totalCredit)
    for (d in section.payments) paymentDocument(w, d)
    w.endElement()
    return
}

private fun fileStart(var w: XmlWriter, h: SaftHeader, m: SaftMasterFiles): void {
    w.declaration()
    w.startElement("AuditFile")
    w.namespace("", saftNamespace)
    header(w, h)
    masterFiles(w, m)
    return
}

// The file's bytes, or the issues that stopped it: any issue of severity error from
// saftCheck refuses to write. Warnings come back with a successful result.
fun saftWrite(file: SaftFile, options: SaftWriteOptions = SaftWriteOptions()): SaftWriteResult {
    val issues = if (options.unchecked) array<SaftIssue>() else saftCheck(file)
    if (saftHasErrors(issues)) return SaftWriteResult(false, "", issues, "the file has errors: see issues")
    val w = xmlWriter(XmlWriterOptions(encoding = options.encoding, indent = options.indent))
    fileStart(w, file.header, file.masterFiles)
    if (file.salesInvoices != null || file.movementOfGoods != null || file.workingDocuments != null || file.payments != null) {
        w.startElement("SourceDocuments")
        invoices(w, file.salesInvoices)
        movements(w, file.movementOfGoods)
        workDocuments(w, file.workingDocuments)
        receipts(w, file.payments)
        w.endElement()
    }
    w.endElement()
    val result = w.finish()
    SaftWriteResult(result.succeeded, result.text, issues, result.errorMessage)
}

// A sink for saftStreamWriter or a source for saftStreamReader, on a file.
fun saftFileSink(filePath: Path): XmlFileSink = xmlFileSink(filePath)

// Where a stream writer can get its documents from, when it isn't handed them one by one.
interface SaftInvoices { fun next(): SaftInvoice? }
interface SaftMovements { fun next(): SaftStockMovement? }
interface SaftWorkDocuments { fun next(): SaftWorkDocument? }
interface SaftReceipts { fun next(): SaftPayment? }

class SaftStreamResult(
    val succeeded: bool,
    val errorMessage: string,
    // What the check found, up to maxIssues of each severity.
    val issues: array<SaftIssue>,
    val issuesDropped: int,
    val documents: int,
    val bytesWritten: int
)

private val SECTION_NONE = 0
private val SECTION_SALES = 1
private val SECTION_GOODS = 2
private val SECTION_WORK = 3
private val SECTION_PAYMENTS = 4

// saftWrite a document at a time. The header and master files are written at once and
// each document as it is given, in memory for no more than that; control totals come
// before the documents in the file, so they are given up front, computed by the caller,
// from SQL for instance, and compared with the documents at the end of each section.
//
// The output is the bytes saftWrite gives for the same data. A check error stops the
// writer where it is found, or at a section's end for a wrong total; finish() then says
// so and what the sink got so far isn't a file, which is the caller's to discard.
class SaftStreamWriter(
    val w: XmlWriter,
    val check: SaftStreamCheck,
    val unchecked: bool,
    var section: int = 0,
    var last: int = 0,
    var inSources: bool = false,
    var declaredEntries: int = 0,
    var declaredDebit: SaftDecimal = saftDecimalZero(),
    var declaredCredit: SaftDecimal = saftDecimalZero(),
    var documents: int = 0,
    var problem: string = "",
    var finished: bool = false
) {
    fun checkProblem(): bool {
        if (problem == "" && !unchecked && check.c.errors > 0) problem = "the file has errors: see issues"
        problem != ""
    }

    fun refuse(message: string): void {
        if (problem == "") problem = message
        return
    }

    fun begin(wanted: int): bool {
        if (checkProblem()) return false
        if (section != SECTION_NONE) {
            refuse("a section is still open: call endSection first")
            return false
        }
        if (wanted <= last) {
            refuse("sections go in the order SalesInvoices, MovementOfGoods, WorkingDocuments, Payments, each once")
            return false
        }
        if (!inSources) {
            w.startElement("SourceDocuments")
            inSources = true
        }
        section = wanted
        last = wanted
        check.startSection()
        true
    }

    fun startSalesInvoices(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal): void {
        if (!begin(SECTION_SALES)) return
        declaredEntries = numberOfEntries
        declaredDebit = totalDebit
        declaredCredit = totalCredit
        sectionStart(w, "SalesInvoices", numberOfEntries, totalDebit, totalCredit)
        return
    }

    fun startMovementOfGoods(numberOfMovementLines: int, totalQuantityIssued: SaftDecimal): void {
        if (!begin(SECTION_GOODS)) return
        declaredEntries = numberOfMovementLines
        declaredDebit = totalQuantityIssued
        movementsStart(w, numberOfMovementLines, totalQuantityIssued)
        return
    }

    fun startWorkingDocuments(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal): void {
        if (!begin(SECTION_WORK)) return
        declaredEntries = numberOfEntries
        declaredDebit = totalDebit
        declaredCredit = totalCredit
        sectionStart(w, "WorkingDocuments", numberOfEntries, totalDebit, totalCredit)
        return
    }

    fun startPayments(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal): void {
        if (!begin(SECTION_PAYMENTS)) return
        declaredEntries = numberOfEntries
        declaredDebit = totalDebit
        declaredCredit = totalCredit
        sectionStart(w, "Payments", numberOfEntries, totalDebit, totalCredit)
        return
    }

    fun ready(wanted: int): bool {
        if (checkProblem()) return false
        if (section != wanted) {
            refuse("a document of another section: start its section first")
            return false
        }
        documents = documents + 1
        true
    }

    // Each document is checked as saftCheck would, and written if it passes.
    fun invoice(d: SaftInvoice): void {
        if (!ready(SECTION_SALES)) return
        if (!unchecked) check.invoice(d)
        if (!checkProblem()) invoiceDocument(w, d)
        return
    }

    fun movement(d: SaftStockMovement): void {
        if (!ready(SECTION_GOODS)) return
        if (!unchecked) check.movement(d)
        if (!checkProblem()) movementDocument(w, d)
        return
    }

    fun workDocument(d: SaftWorkDocument): void {
        if (!ready(SECTION_WORK)) return
        if (!unchecked) check.workDocument(d)
        if (!checkProblem()) workDocumentElement(w, d)
        return
    }

    fun payment(d: SaftPayment): void {
        if (!ready(SECTION_PAYMENTS)) return
        if (!unchecked) check.payment(d)
        if (!checkProblem()) paymentDocument(w, d)
        return
    }

    // Compares the totals the section started with to its documents. Writing the
    // section's end is what a wrong total refuses.
    fun endSection(): void {
        if (section == SECTION_NONE) {
            refuse("no section is open")
            return
        }
        val ending = section
        section = SECTION_NONE
        if (checkProblem()) return
        if (!unchecked) {
            if (ending == SECTION_SALES) check.endDebitCredit("SalesInvoices", declaredEntries, declaredDebit, declaredCredit)
            if (ending == SECTION_GOODS) check.endMovements(declaredEntries, declaredDebit)
            if (ending == SECTION_WORK) check.endDebitCredit("WorkingDocuments", declaredEntries, declaredDebit, declaredCredit)
            if (ending == SECTION_PAYMENTS) check.endDebitCredit("Payments", declaredEntries, declaredDebit, declaredCredit)
            if (checkProblem()) return
        }
        w.endElement()
        return
    }

    // A whole section from an iterator, such as one paging through a database.
    fun salesInvoices(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal, documents: SaftInvoices): void {
        startSalesInvoices(numberOfEntries, totalDebit, totalCredit)
        while (problem == "") {
            val d = documents.next()
            if (d == null) break
            invoice(d)
            checkProblem()
        }
        endSection()
        return
    }

    fun movementOfGoods(numberOfMovementLines: int, totalQuantityIssued: SaftDecimal, documents: SaftMovements): void {
        startMovementOfGoods(numberOfMovementLines, totalQuantityIssued)
        while (problem == "") {
            val d = documents.next()
            if (d == null) break
            movement(d)
            checkProblem()
        }
        endSection()
        return
    }

    fun workingDocuments(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal, documents: SaftWorkDocuments): void {
        startWorkingDocuments(numberOfEntries, totalDebit, totalCredit)
        while (problem == "") {
            val d = documents.next()
            if (d == null) break
            workDocument(d)
            checkProblem()
        }
        endSection()
        return
    }

    fun payments(numberOfEntries: int, totalDebit: SaftDecimal, totalCredit: SaftDecimal, documents: SaftReceipts): void {
        startPayments(numberOfEntries, totalDebit, totalCredit)
        while (problem == "") {
            val d = documents.next()
            if (d == null) break
            payment(d)
            checkProblem()
        }
        endSection()
        return
    }

    // Ends the file and closes the sink, which happens also after a problem.
    fun finish(): SaftStreamResult {
        if (section != SECTION_NONE && !checkProblem()) refuse("a section is still open: call endSection first")
        checkProblem()
        if (problem != "" && !w.failed()) w.fail("refused", problem)
        if (problem == "" && !finished) {
            if (inSources) w.endElement()
            w.endElement()
        }
        finished = true
        val result = w.finish()
        val message = if (problem != "") problem else result.errorMessage
        SaftStreamResult(problem == "" && result.succeeded, message, check.issues(), check.c.dropped, documents, result.bytesWritten)
    }
}

// Starts a file: the header and master files go through the check and out to the sink.
// `maxIssues` keeps that many of each severity. `maxNumbers` bounds the memory for finding
// repeated document numbers, which a series numbered in sequence hardly uses.
fun saftStreamWriter(h: SaftHeader, m: SaftMasterFiles, sink: XmlSink, options: SaftWriteOptions = SaftWriteOptions(), maxIssues: int = 1000, maxNumbers: int = 1048576): SaftStreamWriter {
    val w = xmlStreamWriter(sink, XmlWriterOptions(encoding = options.encoding, indent = options.indent))
    val check = saftStreamCheck(h, m, maxIssues, maxNumbers)
    val out = SaftStreamWriter(w, check, options.unchecked)
    if (!out.checkProblem()) fileStart(w, h, m)
    out
}
